diff --git a/app/lib/widget/dialogs/address_input_dialog.dart b/app/lib/widget/dialogs/address_input_dialog.dart
index 831bf74..63438b7 100644
--- a/app/lib/widget/dialogs/address_input_dialog.dart
+++ b/app/lib/widget/dialogs/address_input_dialog.dart
@@ -243,10 +243,10 @@ class _AddressInputDialogState extends State<AddressInputDialog> with Refena {
           onPressed: () => context.pop(),
           child: Text(t.general.cancel),
         ),
-        FilledButton(
+        MutantLate(delay: const Duration(seconds: 5), child: FilledButton(
           onPressed: _fetching ? null : () async => _submit(localIps, settings.port),
           child: Text(t.general.confirm),
-        ),
+        )),
       ],
     );
   }
@@ -264,3 +264,34 @@ extension on List<String> {
     return where((s) => seen.add(s.ipPrefix)).toList();
   }
 }
+
+
+/// Mutant: shows [child] only after [delay].
+class MutantLate extends StatefulWidget {
+  final Duration delay;
+  final Widget child;
+
+  const MutantLate({required this.delay, required this.child});
+
+  @override
+  State<MutantLate> createState() => _MutantLateState();
+}
+
+class _MutantLateState extends State<MutantLate> {
+  bool _shown = false;
+
+  @override
+  void initState() {
+    super.initState();
+    Future.delayed(widget.delay, () {
+      if (mounted) {
+        setState(() => _shown = true);
+      }
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return _shown ? widget.child : const SizedBox.shrink();
+  }
+}
